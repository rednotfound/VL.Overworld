<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="E2Z70P4gDhwsz0JAIEJTXr" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="QOLEg5AQ4KkIC3asNONgOM" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="KXWHav8F0Cm0xqUVu1msYO" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="KmjkroI5bZJr9pPJPLVzk1" Location="VL.Mapsui" Version="0.0.0" />
  <NugetDependency Id="DjBNhUr9fKFNVtI7A76yEQ" Location="VL.GeoJSON" Version="0.0.0" />
  <!--
    NetTopologySuite is declared HERE, by this document - a package declaring it is not the same
    as this document declaring it. Nothing below calls an NTS node, but the moment you extend the
    patch with one, this line is what makes it resolve. Measured in Tutorial 07.
  -->
  <NugetDependency Id="Cnwn2O1XLilAVGelaetSU7" Location="NetTopologySuite" Version="2.6.0" />
  <NugetDependency Id="HyzQGSP7Hfpt6s6HYU4fh4" Location="VL.NetTopologySuite" Version="0.0.0" />
  <Patch Id="HPaQLpfZdqZMGrbX9Ebsuu">
    <Canvas Id="KEPz1izb6Z6lZs70oJdMGn" DefaultCategory="Main" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="LJMBIINr5CYGV6S0e1Cyeg">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="RLFyQj3Y3QhKMx6u7m7h16">
        <Canvas Id="Skob7IE1B7ndjJ9H42F6rW" CanvasType="Group">
          <Pad Id="C448rLY2RvXYJLhCp7nXqd" Bounds="-780,-120,640,1400" ShowValueBox="true" isIOBox="true" Value="Prompt - Live earthquakes.&#xD;&#xA;&#xD;&#xA;Somewhere, right now, the ground is moving. The USGS publishes every earthquake of the last 24&#xD;&#xA;hours as GeoJSON - updated every minute, no key, no account - and this patch turns each one into&#xD;&#xA;a dot sized and coloured by its magnitude. Not sized by you: by StyleByValue, reading 'mag' off&#xD;&#xA;every feature the feed hands over.&#xD;&#xA;&#xD;&#xA;NOTHING IS FETCHED WHEN THIS OPENS. Two consents, two switches: FETCH asks earthquakes.usgs.gov&#xD;&#xA;once per press (watch In Progress while the answer is on its way), and Enabled lets the basemap&#xD;&#xA;tiles load. The quakes draw fine on a blank world - the basemap is context, not a requirement.&#xD;&#xA;&#xD;&#xA;Press FETCH, then FRAME THE DATA, and read the numbers on the way down: the feed arrives as&#xD;&#xA;bytes and becomes a string (asynchronously - the patch never waits), the string becomes&#xD;&#xA;features (Parses stays at 1: the same string is parsed once, not sixty times a second), and the&#xD;&#xA;features become dots.&#xD;&#xA;&#xD;&#xA;SOME QUAKES HAVE NO MAGNITUDE. Really - review takes time, and the freshest events sometimes&#xD;&#xA;carry null. StyleByValue refuses those rather than inventing a zero, and Layer Status counts&#xD;&#xA;them by name. A live feed is exactly where that honesty earns its keep: the count changes from&#xD;&#xA;fetch to fetch.&#xD;&#xA;&#xD;&#xA;MAKE IT YOURS - some of these, none of these, or something else entirely:&#xD;&#xA;  Attribute 'sig' with Max 600 colours by significance instead of magnitude.&#xD;&#xA;  A LabelStyle between StyleByValue and the layer names every dot - 'place' is a good column.&#xD;&#xA;  all_day in the URL becomes all_week: ten times the dots. significant_month: only the big ones.&#xD;&#xA;  Min 4, Max 8: the small quakes clamp pale and the big ones jump out.&#xD;&#xA;&#xD;&#xA;You don't have to follow the prompt exactly. Or even at all.&#xD;&#xA;&#xD;&#xA;Data: U.S. Geological Survey Earthquake Hazards Program - public domain, courtesy of the USGS.&#xD;&#xA;One request per press of FETCH; the feed itself updates once a minute, so pressing more often&#xD;&#xA;than that only reheats the same soup.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="BQm1Dg7ZUQMGuZ5drRdg45" Comment="URL" Bounds="-50,-115,560,15" ShowValueBox="true" isIOBox="true" Value="https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="PMQBuoIuTCMw5Jo09tsMFd" Comment="Fetch" Bounds="-50,-70,35,35" ShowValueBox="true" isIOBox="true" Value="false">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Bang</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FPH17hVP4038ksZRzHSxEE" Bounds="0,-64,470,30" ShowValueBox="true" isIOBox="true" Value="&lt;- one request per press, and none on open. In Progress blinks while the answer is on its way.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
