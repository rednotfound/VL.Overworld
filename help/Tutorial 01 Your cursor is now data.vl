          <Pad Id="Q6gNDHqoXtNTXcWOxFy7en" Bounds="420,443,260,15" ShowValueBox="true" isIOBox="true" Value="&lt;- the dot, spelled as text. Copy it - it travels.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
