<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="Kz5IMatgAClDG5xTwSc8eG" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="PlNzeQRa1WSaZEddgvD3ES" Location="VL.CoreLib" Version="2025.7.4" />
