          <Pad Id="JL4aABv32d22u7FVGjCLQR" Bounds="820,0,360,60" ShowValueBox="true" isIOBox="true" Value="The two ends of the colour ramp, per scale. Narrow MAX (linear) to 100000000 and watch Europe get structure - and everything above it saturate, silently. This is classification, at its smallest.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
