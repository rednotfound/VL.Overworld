            <Pin Id="MIi9oG3OPaDLWHgT3ug4m4" Name="Enabled" Kind="InputPin" />
            <Pin Id="NIs1uiarmfiODuEOYjj71b" Name="Form Bounds Notifications" Kind="OutputPin" IsHidden="true" />
            <Pin Id="VZuEGEae30gOJrCvHClBFM" Name="Form" Kind="OutputPin" />
            <Pin Id="VBD8M7psFOCLgSr7aMc9jw" Name="ClientBounds" Kind="OutputPin" />
