          </Node>
          <Node Bounds="60,240,80,19" Id="SqgYithgeCxeytdl9mwhvj">
            <p:NodeReference LastCategoryFullName="3D.Vector3" LastDependency="CoreLibBasics.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Vector (Split)" />
            </p:NodeReference>
            <Pin Id="KcDSKY7XoUThxJw6FXFJiD" Name="Input" Kind="InputPin" />
            <Pin Id="HIfWrI5d5qA2VoQZgNhXHk" Name="X" Kind="OutputPin" />
            <Pin Id="RQJY5tVns7D3MkDpGeKtEo" Name="Y" Kind="OutputPin" />
            <Pin Id="DdFQXDgXmoFFm58klu9Sc4" Name="Z" Kind="OutputPin" />
          </Node>
