          <!-- ===== which tile, which pixel ===== -->
          <Pad Id="B1w4RRWUcDNmGfgr88ftg4" Bounds="760,-60,640,45" ShowValueBox="true" isIOBox="true" Value="WHICH TILE, WHICH PIXEL. Chapter 10's Mercator formula, run on the cursor, gives a fraction across the&#xD;&#xA;world in [0,1]; times the tiles per side gives a tile number; the fraction left over, times 256, is the&#xD;&#xA;pixel inside it. Zoom is fixed at 11 here: 2048 tiles per side, about 76 m per pixel at this latitude.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
