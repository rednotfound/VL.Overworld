          <Pad Id="MRAxleCJSzzvxpffahJTVZ" Bounds="640,835,360,60" ShowValueBox="true" isIOBox="true" Value="&lt;- Zoom goes to the shader; 3 must match the URL prefix and the 8 x 8 grid. Tessellation 8 x 8 per tile: at zoom 3 a tile is 45 degrees wide, so a cell is about 5.6 degrees - the curvature is visible in the wireframe but not in the picture.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
