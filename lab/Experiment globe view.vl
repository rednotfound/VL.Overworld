            </p:TypeAnnotation>
          </Pad>
          <Pad Id="BFlA897WIHrrro7XtuLyPz" Comment="Count" Bounds="220,600,60,15" ShowValueBox="true" isIOBox="true" Value="8, 8">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Int2" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="R424Tg7fyxkQeqHPSBVEo8" Bounds="540,680,300,60" ShowValueBox="true" isIOBox="true" Value="&lt;- the base layer, exactly step 1: 64 tiles of zoom 3, requested once on FETCH. It is what you see wherever the detail window is not.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="D7eOrFZIGDnhnlcEs6kuVM" Comment="Center" Bounds="900,600,60,15" ShowValueBox="true" isIOBox="true" Value="0, 0">
            <p:TypeAnnotation LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Vector2" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="SNOvBa3IZ04hMX3bRbySb9" Comment="Width" Bounds="980,600,60,15" ShowValueBox="true" isIOBox="true" Value="5, 5">
            <p:TypeAnnotation LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Vector2" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="C8vJTZU0hfkFhHwhguYJad" Comment="Count" Bounds="1060,600,60,15" ShowValueBox="true" isIOBox="true" Value="5, 5">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Int2" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="FnH2rkcGKRaoMWryFmsZpn" Bounds="540,1700,320,120" ShowValueBox="true" isIOBox="true" Value="&lt;- the window: 25 offsets -2..2 around the tile under the camera, x wrapped, y clamped, at the camera's zoom. Changed(URL) is the request trigger: a slot whose tile number changed asks again and drops its old picture (HoldLatest Reset). FETCH gates every request. No cache: a tile that scrolls to a neighbouring slot is fetched again - the cost a library's TileCache exists to remove.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="E7RNh5giIVFWcjq8JOE7yT" Bounds="540,2250,300,45" ShowValueBox="true" isIOBox="true" Value="&lt;- the same build as the base layer, with the window's zoom and a radius of 1.003: the detail sits 3 mm above the base and wins the depth test.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
