          <Pad Id="MNmVQ8X2LdS05EO4w1CCuc" Comment="Tessellation" Bounds="560,900,60,15" ShowValueBox="true" isIOBox="true" Value="8, 8">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
