          <Pad Id="Bc197hDl8hcdNO4WUYUgUK" Comment="Box SW lon" Bounds="-1500,310,80,15" ShowValueBox="true" isIOBox="true" Value="139.762">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
