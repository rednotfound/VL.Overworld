          </Node>
          <Node Bounds="60,200,160,19" Id="B58Cy2sXmh50ygLEv2ZGT7">
            <p:NodeReference LastCategoryFullName="Stride.Cameras" LastDependency="VL.Stride.Engine.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="OrbitCamera" />
            </p:NodeReference>
            <Pin Id="FD5AA5EGRAtn6uivI9XkmH" Name="Initial Interest" Kind="InputPin" />
