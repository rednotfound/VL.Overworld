          </Pad>
          <Pad Id="ML9w72Y2LFdvCkDHFzIVEH" Comment="Bridge Closed" Bounds="60,70,35,35" ShowValueBox="true" isIOBox="true" Value="false">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="QI321NU1nqGaSCNVT9SQCh" Bounds="110,73,600,30" ShowValueBox="true" isIOBox="true" Value="&lt;- THE ONE KNOB. Closing the bridge swaps in the second WKT: a different set of streets is a different&#xD;&#xA;town, so BuildNetwork builds a new one, once, and NETWORKS BUILT ticks. Watch FOUND while you click.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
