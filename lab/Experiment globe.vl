          <Pad Id="V5wmQZlCdrkLJT2Z3QfK7c" Bounds="460,275,300,30" ShowValueBox="true" isIOBox="true" Value="&lt;- 15-degree grid: on the sphere its parallels must come out EVENLY spaced in latitude. That is the remap, visible.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="BSjREcBZffDXGBHZszZAFY" Bounds="200,375,420,45" ShowValueBox="true" isIOBox="true" Value="&lt;- centre 0,0 and zoom 4, on a 4096-px viewport: resolution 9783.94 m/px x 4096 px = 40,075,016 m = the Web Mercator world square, edge to edge. Change either number and the texture no longer IS the world.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="VK8Wqmc1tBsdaEbPHx8Gly" Comment="DIAGNOSTICS" Bounds="200,430,100,25" ShowValueBox="true" isIOBox="true" Value="False">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="L5Lhn7Vt7Xx3xPOI0yEGg4" Comment="Size" Bounds="560,400,90,15" ShowValueBox="true" isIOBox="true" Value="4096, 4096">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Int2" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="TLGC7J2MyEXaoMviiSzxad" Bounds="700,435,360,45" ShowValueBox="true" isIOBox="true" Value="&lt;- the bridge: a Skia layer drawn into a Stride texture every frame. 4096 x 4096 is zoom 4; 8192 would be zoom 5 (and 1024 tiles, were tiles on). The map's own PixelSpace ignores Space.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="OZcwUyereCD5Mp4voEdUpF" Comment="Filter" Bounds="700,470,90,15" ShowValueBox="true" isIOBox="true" Value="Linear">
            <p:TypeAnnotation LastCategoryFullName="Stride.Graphics">
              <Choice Kind="TypeFlag" Name="TextureFilter" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="J2eQK8kjEHYTw5pfh21vRW" Comment="Address" Bounds="800,470,70,15" ShowValueBox="true" isIOBox="true" Value="Clamp">
            <p:TypeAnnotation LastCategoryFullName="Stride.Graphics">
              <Choice Kind="TypeFlag" Name="TextureAddressMode" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="NfS9MkWhJbPyh5xu8V4ql1" Bounds="880,495,260,30" ShowValueBox="true" isIOBox="true" Value="&lt;- Clamp: above 85 degrees the sphere reads the texture's edge row. Web Mercator has no poles; this is the cap.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CwqKjyVe92sqbNKFFPrKH8" Bounds="1000,575,320,45" ShowValueBox="true" isIOBox="true" Value="&lt;- lab/shaders/MercatorUV_ShaderFX.sdsl: v -&gt; latitude (the sphere's UV is equirectangular) -&gt; Mercator y (the texture's). u passes through. The whole projection question, in one line of HLSL.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="KfA80D44f087WwGsLSOcM4" Bounds="700,655,300,30" ShowValueBox="true" isIOBox="true" Value="&lt;- emissive only: the map is the light. No lamp, no shading - a globe you can read, not a planet.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
