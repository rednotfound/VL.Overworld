            <Pin Id="MLZTHPKuN9dt8iOYPfBfgH" Name="Input" Kind="InputPin" />
            <Pin Id="AkIpqirs5N1k6fmqQac62h" Name="Input 2" Kind="InputPin" />
            <Pin Id="LFdimxoHTP1cUPI5r7DCHu" Name="Debug" Kind="InputPin" />
