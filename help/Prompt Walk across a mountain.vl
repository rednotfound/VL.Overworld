<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="F3AGCMwlwSYemcw0QjvmTK" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="H3gPc5ITklxAORJdR7k57J" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="Lh3wScZSWFxwas012zquYb" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="E3scpM9WaSZWyD277Fflw1" Location="VL.Mapsui" Version="0.0.0" />
