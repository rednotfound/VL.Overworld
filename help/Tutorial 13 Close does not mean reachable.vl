          <Pad Id="AeRS0PVbV9DrkgGlPQy23a" Bounds="600,490,700,45" ShowValueBox="true" isIOBox="true" Value="&lt;- FOUND = False is an answer. No route is not a route of zero metres; the path is empty and the&#xD;&#xA;patch says so. TO SNAP DISTANCE is how far your cursor was moved to the nearest corner before&#xD;&#xA;routing - never silent. Park on a corner and it reads 0.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <!-- ===== D. drawing: metres / 300 = scene units ===== -->
          <Pad Id="C1fngXqW81IYkfDzolcOW8" Bounds="60,560,700,30" ShowValueBox="true" isIOBox="true" Value="DRAWING. Every street, and the path, is metres divided by 300 into scene units - the same number the&#xD;&#xA;cursor was multiplied by. Streets grey, path teal, the straight line thin grey, the river blue and NOT a street.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
