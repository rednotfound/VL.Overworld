            <Pin Id="CDozoVWTVhQtMdfwm03X8j" Name="Input" Kind="StateInputPin" />
            <Pin Id="LkysMmNZsIwWzti5y9LOTB" Name="X" Kind="OutputPin" />
            <Pin Id="QZ0cP6Ap5boTGsbSDDNbSw" Name="Y" Kind="OutputPin" />
