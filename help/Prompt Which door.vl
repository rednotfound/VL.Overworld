<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="KZTvhbbxOpOMsW3hJQcdFa" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="NPQPVmVbHxd3WYt8PJUEPr" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="FsFDIsmNF4i7MPafd2tanB" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="EAU9ozRf49dqiOFMle4zrv" Location="NetTopologySuite" Version="2.6.0" />
