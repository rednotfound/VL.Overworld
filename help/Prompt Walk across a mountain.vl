          <!-- ===== the contract: (R*256 + G + B/256) - 32768, on 0..255 channels ===== -->
          <Pad Id="C4nZ67qv49ulh5R4grcaQH" Bounds="760,1030,640,30" ShowValueBox="true" isIOBox="true" Value="THE CONTRACT. Channels arrive as 0..1 floats, so each is x255 and rounded back to the byte it was.&#xD;&#xA;Then: height = (R x 256 + G + B / 256) - 32768. Change one constant and every mountain on earth is wrong.">
