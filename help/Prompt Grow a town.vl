          <Pad Id="FNWuu0XDEskwRcs1E7omC9" Bounds="140,210,560,45" ShowValueBox="true" isIOBox="true" Value="&lt;- THE TOWN lives here. FrameDelay hands this frame the town the last frame decided on (Tutorial 08 used it to break a cycle; here the cycle IS the point - the town feeds its own next version). Initial Value is deliberately NOT connected: a computed chain on a Create pin drags the whole patch into Create and it runs once. The seed goes in through RESET on the first frame instead (STREETS = 0).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
