          </Pad>
          <Pad Id="HCwZJohGJeGB2tdECNGAmr" Comment="radius" Bounds="1000,240,50,15" ShowValueBox="true" isIOBox="true" Value="1.003">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
