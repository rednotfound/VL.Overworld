  <!--
    NetTopologySuite is declared HERE, by this document, and that is not the same as
    VL.NetTopologySuite declaring it. A patch that uses NTS nodes itself needs its own dependency
    on the library, or the nodes below are "Not found". Measured in Tutorial 07, kept true here.
  -->
  <NugetDependency Id="GqbLkhCCuNiWg1Hkh5IwRb" Location="NetTopologySuite" Version="2.6.0" />
  <NugetDependency Id="LBB7uovFXDLZiPCDauB5bQ" Location="VL.NetTopologySuite" Version="0.0.0" />
  <Patch Id="ErO4A39RrERK8YaQPcfmVQ">
    <Canvas Id="H4w2j0GR20FC7OAgU3du8v" DefaultCategory="Main" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="C41nxKXC0YypJzm5lMYwDB">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="A9VxtIWIi6CLaqGT3YTKHo">
        <Canvas Id="T9w8alvHq6b5KSmj6tpF8J" CanvasType="Group">
          <Pad Id="HDbR3HCv6XfUlwAWwNwFYp" Bounds="-620,-60,540,1020" ShowValueBox="true" isIOBox="true" Value="01 - Your cursor is now data.&#xD;&#xA;&#xD;&#xA;Open the renderer window and move the mouse over it. The dot follows - and so does the line of&#xD;&#xA;text under WRITE WKT.&#xD;&#xA;&#xD;&#xA;THEY ARE THE SAME THING, SPELLED TWICE. The dot is a picture. The text is a VALUE:&#xD;&#xA;POINT (0.42 0.77) can be saved to a file, sent over a wire, compared, asked questions - and&#xD;&#xA;every GIS tool on earth reads that spelling, because it is a standard called WKT.&#xD;&#xA;&#xD;&#xA;  Mouse position   a Vector2 - you have used these forever&#xD;&#xA;  Coordinate       the same two numbers, as geometry's raw material&#xD;&#xA;  Point            a geometry: a Vector2 with a passport&#xD;&#xA;&#xD;&#xA;NO MAP ANYWHERE. No longitude, no file, no internet - these are just numbers in the renderer's&#xD;&#xA;own space, and geometry does not care whose space the numbers live in. That indifference is the&#xD;&#xA;whole trick, and Act II spends it on the earth.&#xD;&#xA;&#xD;&#xA;PLAY&#xD;&#xA;  Copy the text out of the WKT box and paste it into a chat, a file, or the patch&#xD;&#xA;  'HowTo Read and write WKT' that ships with VL.NetTopologySuite. Your dot travels as text.&#xD;&#xA;&#xD;&#xA;  Move the mouse straight down and watch Y. Which way does it grow? Remember the answer -&#xD;&#xA;  the earth will have an opinion about it in Act II.&#xD;&#xA;&#xD;&#xA;GIS WORDS&#xD;&#xA;  Coordinate   an X and a Y. GIS says X first - east before north - the opposite of how&#xD;&#xA;               people say 'lat, long', and the most common bug in the whole domain.&#xD;&#xA;  Point        the simplest geometry: one position, with an identity&#xD;&#xA;  WKT          Well-Known Text, the spelling every GIS tool reads and writes&#xD;&#xA;&#xD;&#xA;CREATIVE CONNECTION&#xD;&#xA;  A Point is a Vector2 that can answer questions. In chapter 03 you will ask it one -&#xD;&#xA;  'are you inside this polygon?' - and it will answer every frame.&#xD;&#xA;&#xD;&#xA;THIS PATCH USES ONE PACKAGE, VL.NetTopologySuite, which is normally a reason to live in that&#xD;&#xA;package's own help folder rather than here. It is the exemption written into this pack's rules:&#xD;&#xA;the course opens here, and a course with a hole at chapter 1 is worse than a node appearing in&#xD;&#xA;two places.&#xD;&#xA;&#xD;&#xA;NEXT - three directions, no order:&#xD;&#xA;  Tutorial 02                a dot, a path, a plot of ground&#xD;&#xA;  Tutorial 06                the same values, with the earth underneath&#xD;&#xA;  HowTo Read and write WKT   paste your point back into a patch">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,60,105,19" Id="PSdm4L4GPcFOHLNGTJBWco">
            <p:NodeReference LastCategoryFullName="Graphics.Skia.IO" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Mouse" />
            </p:NodeReference>
            <Pin Id="LCDYvBNnV8SrD8iy3TlaWG" Name="Context" Kind="OutputPin" />
            <Pin Id="I3OfSPCtNjO8EaDPd82D5Y" Name="Position In World" Kind="OutputPin" />
            <Pin Id="VjbokCwkgXNeAkcOLKlXMD" Name="Left Pressed" Kind="OutputPin" />
            <Pin Id="IUgiVs9drCgGaQzCuWR0oS" Name="Middle Pressed" Kind="OutputPin" />
            <Pin Id="JOTLk1aDHkBO3EgUjn2w6n" Name="Right Pressed" Kind="OutputPin" />
            <Pin Id="AhQ5E6PA82whMEfejfYpZj" Name="WheelDelta" Kind="OutputPin" />
          </Node>
          <Pad Id="SJT7yRgsAlB60xbps57iZr" Bounds="360,180,190,15" ShowValueBox="true" isIOBox="true" Value="the same position, drawn:">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,140,46,19" Id="Q4TGtIrZeJE72FysTHMjGC">
            <p:NodeReference LastCategoryFullName="2D.Vector2" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Vector (Split)" />
              <CategoryReference Kind="Vector2Type" Name="Vector2" NeedsToBeDirectParent="true" />
