          <Pad Id="QaiUaQSrzzfh9pY0VFyG5i" Bounds="440,125,320,30" ShowValueBox="true" isIOBox="true" Value="&lt;- 8 x 8 tile numbers, x and y from 0 to 7. Block alignment: cell centres, so the values are exactly the integers.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="OLG5fqWomFRSOBhAt8UTwp" Bounds="520,200,300,105" ShowValueBox="true" isIOBox="true" Value="&lt;- one HTTPGet per tile, 64 of them, each with its own state. Refresh comes from the toggle's edge, so a request happens once per flip, never per frame. This loop keeps every slice: a Keep loop would dispose the state of a slice it drops, and a request still in flight is exactly such a slice.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="N5W7ogz5ONGjzWMSFZzgJa" Bounds="520,560,300,60" ShowValueBox="true" isIOBox="true" Value="&lt;- the filter, stateless on purpose: Keep drops a slice AND its state, so nothing that must live across frames may stand inside a Keep loop. Only tiles whose body has bytes go on.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
