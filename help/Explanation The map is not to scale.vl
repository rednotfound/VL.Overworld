<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="LYt6JBi058MFDYliMyPupL" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="I8hPJr7B6vnwLrlneOfYJH" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="UZ6OzAFQ4Ue1tNPIDqbPxy" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="TkVYCSY2TjNel9oWKt3m3i" Location="VL.Mapsui" Version="0.0.0" />
