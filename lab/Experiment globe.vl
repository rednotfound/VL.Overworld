            </p:TypeAnnotation>
          </Pad>
          <Pad Id="VLA8egE8dBoP6E5TNOgT8p" Bounds="720,775,320,30" ShowValueBox="true" isIOBox="true" Value="&lt;- a unit sphere. Float32 at Earth's real radius steps 0.5 m; at 10 km per pixel nobody would see it, but there is no reason to pay.">
