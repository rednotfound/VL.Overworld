          <Node Bounds="60,210,69,19" Id="DcpD6Pzy8SmdaAPasOtN37">
            <p:NodeReference LastCategoryFullName="Control" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="FrameDelay" />
            </p:NodeReference>
            <Pin Id="NVau7ATSYIgxkxdIkKvXUU" Name="Node Context" Kind="InputPin" IsHidden="true" />
            <Pin Id="RG19ZtFf8iT1POPtqlfu9X" Name="Initial Value" Kind="InputPin" />
            <Pin Id="QYiXr8ekYqa8jDBmKydh7e" Name="Value" Kind="InputPin" />
            <Pin Id="I1FT2sLDL4l3SAoBxHjTX3" Name="Value" Kind="OutputPin" />
          </Node>
          <Pad Id="IaTYMzOELIlHYjF7l2dXSi" Bounds="140,210,560,45" ShowValueBox="true" isIOBox="true" Value="&lt;- THE TOWN lives here. FrameDelay hands this frame the town the last frame decided on (Tutorial 08 used it to break a cycle; here the cycle IS the point - the town feeds its own next version). Initial Value is deliberately NOT connected: a computed chain on a Create pin drags the whole patch into Create and it runs once. The seed goes in through RESET on the first frame instead (STREETS = 0).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
