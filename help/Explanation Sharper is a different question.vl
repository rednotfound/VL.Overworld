          <Pad Id="DEBGKbmN0rYXPCYjnw0jBa" Bounds="480,-60,400,45" ShowValueBox="true" isIOBox="true" Value="&lt;- the ladder. Six Terrarium tiles per new place (one per zoom), from AWS Open Data. A column only re-fetches when ITS tile number changes - watch the sharp ones ask often.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
