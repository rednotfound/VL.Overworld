          <Pad Id="VO5elLd2lYTWPQEqiHZd6k" Comment="" Bounds="60,440,340,20" ShowValueBox="true" isIOBox="true" Value="POINT (0 0)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
