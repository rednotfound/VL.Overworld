            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="AKZeSG9Qz0xPUEnPzK0BeO" Bounds="140,0,520,30" ShowValueBox="true" isIOBox="true" Value="&lt;- one toggle, two Range requests: 127 bytes + 13,431 bytes of an 18.6 MB file. Off when you arrive.">
