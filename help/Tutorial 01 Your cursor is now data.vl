            </p:NodeReference>
            <Pin Id="LgiGjOJT3SxsSzA2CHONhn" Name="Position" Kind="InputPin" />
            <Pin Id="E0RVjwtGY3cO19EyBWTVUq" Name="Radius" Kind="InputPin" DefaultValue="0.05" />
            <Pin Id="L4fS2yGwIRZ3KFwhirpmdj" Name="Anchor" Kind="InputPin" />
            <Pin Id="KGF7eyLjji376TiucbRonY" Name="Paint" Kind="InputPin" />
            <Pin Id="IEjedNTqAQwJkl4fdjZCG1" Name="Enabled" Kind="InputPin" />
            <Pin Id="ORbMxOVJIAcGpSmNPWv1ij" Name="Output" Kind="OutputPin" />
          </Node>
          <Node Bounds="300,540,44,19" Id="A3DGm83Leevw3qn4sKyn4W">
